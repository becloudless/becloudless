{{- /*
Sets the standard Kubernetes labels on the workloads and the services, and selects with them:
  - `app.kubernetes.io/name`: the name of the chart;
  - `app.kubernetes.io/instance`: the name of the release;
  - `app.kubernetes.io/component`: the id of the resource.

The labels are defaults, the ones the resource sets win (see `base.lib.mergeDefaults`):
  - deployments, statefulSets, daemonSets: `labels`, `selector.matchLabels` and `template.metadata.labels`;
  - jobs: `labels` and `template.metadata.labels` (the selector is generated by the API);
  - cronJobs: `labels` and `jobTemplate.spec.template.metadata.labels`;
  - services: `labels` and `selector`. A service selects the component of its own id, unless its `selector` sets
    `app.kubernetes.io/component`: the other two labels are then added to select a component of the same release (e.g. the headless
    service of a statefulSet). A `selector` without this label selects pods of another release (or operator), it is kept as is.
    A service of type `ExternalName` has no selector.
*/}}
{{- define "base.resources.mutations.standardLabels" }}
  {{- $rootContext := .rootContext }}
  {{- $work := .work }}
  {{- $resource := $work.resource | default dict }}

  {{- $labels := dict
        "app.kubernetes.io/name" $rootContext.Chart.Name
        "app.kubernetes.io/instance" $rootContext.Release.Name
        "app.kubernetes.io/component" .id }}

  {{- /* the pod template is only completed when the resource has one: a missing template must still fail the required check */}}
  {{- $defaults := dict }}
  {{- if has .name (list "deployments" "statefulSets" "daemonSets") }}
    {{- $defaults = dict "labels" (deepCopy $labels) "selector" (dict "matchLabels" (deepCopy $labels)) }}
    {{- if $resource.template }}
      {{- $_ := set $defaults "template" (dict "metadata" (dict "labels" (deepCopy $labels))) }}
    {{- end }}
  {{- else if eq .name "jobs" }}
    {{- $defaults = dict "labels" (deepCopy $labels) }}
    {{- if $resource.template }}
      {{- $_ := set $defaults "template" (dict "metadata" (dict "labels" (deepCopy $labels))) }}
    {{- end }}
  {{- else if eq .name "cronJobs" }}
    {{- $defaults = dict "labels" (deepCopy $labels) }}
    {{- if (($resource.jobTemplate | default dict).spec | default dict).template }}
      {{- $_ := set $defaults "jobTemplate" (dict "spec" (dict "template" (dict "metadata" (dict "labels" (deepCopy $labels))))) }}
    {{- end }}
  {{- else if eq .name "services" }}
    {{- $selector := $resource.selector }}
    {{- if eq ($resource.type | default "") "ExternalName" }}
      {{- $defaults = dict "labels" (deepCopy $labels) }}
    {{- else if not $selector }}
      {{- $defaults = dict "labels" (deepCopy $labels) "selector" (deepCopy $labels) }}
    {{- else if and (kindIs "map" $selector) (hasKey $selector "app.kubernetes.io/component") }}
      {{- $defaults = dict "labels" (deepCopy $labels) "selector" (deepCopy $labels) }}
    {{- else }}
      {{- $defaults = dict "labels" (deepCopy $labels) }}
    {{- end }}
  {{- end }}

  {{- if $defaults }}
    {{- $merged := (include "base.lib.mergeDefaults" (dict "dst" $resource "src" $defaults) | fromYaml).value }}
    {{- $work = set $work "resource" $merged }}
  {{- end }}
  {{- toYaml $work }}
{{- end }}
