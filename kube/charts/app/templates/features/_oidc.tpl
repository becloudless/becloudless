{{- /*
The OIDC client of an app that logs in with authelia, the part of the app of the `oidc` values: the key is the id of the client. The other
part is `oidcClients` of app-authelia, which generates the secrets `authelia-oidc-<id>` (keys `client-id` and `secret`, in the authelia
namespace) that this one copies.

  - `release`: the release that gets the secrets (`<id>-pre` by default), which the app waits for. It is merged with the one of the chart,
    that wins; `dependsOn` is completed.
  - `name`: the name of the ExternalSecret and of the Secret it creates (`<id>-oidc` by default), with the keys `clientIdKey` (`client-id`
    by default) and `secret`.
  - `externalSecret: false`: does not create the ExternalSecret, the chart has its own (template of a configuration file...) with the
    SecretStore `authelia`.
It generates, in the release, the ServiceAccount `authelia-reader`, the SecretStore `authelia` that reads the namespace of authelia, and the
ExternalSecret. The Role that allows this ServiceAccount to read the secret of the client is generated by `oidcClients`.
*/}}
{{- define "app.loader.oidc" }}
  {{- $oidc := $.Values.oidc }}
  {{- if $oidc }}
    {{- if not (kindIs "map" $oidc) }}
      {{- fail "oidc must be a map, keyed by the id of the OIDC client" }}
    {{- end }}
    {{- $allowed := list "release" "name" "clientIdKey" "externalSecret" }}
    {{- $resources := $.Values.resources | default dict }}
    {{- $releases := $resources.fluxHelmReleases | default dict }}

    {{- range $id := keys $oidc | sortAlpha }}
      {{- $entry := get $oidc $id | default dict }}
      {{- range $key := keys $entry }}
        {{- if not (has $key $allowed) }}
          {{- fail (printf "oidc.%s.%s is not an option (%s)" $id $key (join ", " $allowed)) }}
        {{- end }}
      {{- end }}
      {{- $secretName := printf "authelia-oidc-%s" $id }}
      {{- $values := dict
            "serviceAccounts" (dict "authelia-reader" (dict "automountServiceAccountToken" false)) 
            "secretStores" (dict "authelia" (dict "provider" (dict "kubernetes" (dict
              "remoteNamespace" "authelia"
              "server" (dict "caProvider" (dict "type" "ConfigMap" "name" "kube-root-ca.crt" "key" "ca.crt"))
              "auth" (dict "serviceAccount" (dict "name" "ref:authelia-reader")))))) }}
      {{- $external := true }}
      {{- if hasKey $entry "externalSecret" }}
        {{- $external = $entry.externalSecret }}
      {{- end }}
      {{- if $external }}
        {{- $clientIdKey := $entry.clientIdKey | default "client-id" }}
        {{- $_ := set $values "externalSecrets" (dict ($entry.name | default (printf "%s-oidc" $id)) (dict
              "refreshInterval" "1h"
              "secretStoreRef" "ref:authelia"
              "data" (dict
                $clientIdKey (dict "secretKey" $clientIdKey "remoteRef" (dict "key" $secretName "property" "client-id"))
                "secret" (dict "secretKey" "secret" "remoteRef" (dict "key" $secretName "property" "secret"))))) }}
      {{- end }}
      {{- $generated := dict
            "dependsOn" (list
              (dict "name" "app-external-secrets" "namespace" "external-secrets")
              (dict "name" "authelia-pre" "namespace" "authelia"))
            "values" (dict "resources" $values) }}
      {{- include "app.lib.mergeRelease" (dict "releases" $releases "name" ($entry.release | default (printf "%s-pre" $id)) "generated" $generated) }}
    {{- end }}

    {{- $_ := set $resources "fluxHelmReleases" $releases }}
    {{- $_ := set $.Values "resources" $resources }}
  {{- end }}
{{- end }}
