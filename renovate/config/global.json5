{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Paris)",
    "customManagers:dockerfileVersions",
  ],
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  // the bots commit on the renovate branches too (charts.yaml regenerates the ci-results): it is not a modification by someone else
  gitIgnoredAuthors: ["/\\[bot\\]@users\\.noreply\\.github\\.com$/"],

  automergeType: "branch",
  automergeStrategy: "squash",

  branchConcurrentLimit: 0,
  // TODO platform automerge requires to put some mandatory checks, else it will be merged, even if the CI is red
  //platformAutomerge: true, // do not wait for next renovate run if the platform support automerge
  minimumReleaseAge: "3 days",
  minimumReleaseAgeBehaviour: "timestamp-optional", // timestamp-required makes renovate never creating PR for packages without timestamp
  labels: ["dependencies"],

  "github-actions": {
    enabled: true,
    pinDigests: true,
  },
  flux: {
    fileMatch: [".+\\.yaml$"],
  },
  "helm-values": {
    enabled: false, // handled by a custom manager which supports renovate comments
  },
  kubernetes: {
    fileMatch: [".+\\.yaml$"],
  },
  nix: {
    enabled: true,
  },

  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    extends: ["schedule:daily"],
  },

  postUpdateOptions: ["gomodTidy"],

  // the ci-results are rendered from the values, without the `# renovate:` comments: they would be looked up as plain docker images and conflict with the
  // updates of the values. They are regenerated by the postUpgradeTasks below
  ignorePaths: ["**/node_modules/**", "**/bower_components/**", "**/ci/ci-result.yaml"],

  customManagers: [
    {
      customType: "regex",
      description: "Docker image and tag classic helm values declaration",
      managerFilePatterns: ["**/*.yaml"],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}",
      matchStrings: [
        'image:\\s+repository:\\s*(?<depName>.+?)\\s+(#\\s*renovate:\\s*versioning=(?<versioning>.+?)\\s*)?tag:\\s*\\"?(?<currentValue>[^\\"\\s]+)\\"?\\s',
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Docker image in a plain `image: name:tag` line (containers, initContainers...) of any yaml file. The optional comment `# renovate: datasource=<ds> packageName=<name> extractVersion=<regex> versioning=<v>` (each one optional, in this order) looks the versions up elsewhere than the registry, e.g. `datasource=github-releases packageName=owner/repo`, as the docker datasource has no release timestamp on ghcr.io (minimumReleaseAge would be skipped)",
      managerFilePatterns: ["**/*.yaml"],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}",
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}docker{{/if}}",
      matchStrings: [
        '(?:^|\\n)[ \\t]*(?:-[ \\t]+)?image:[ \\t]*[\\"\']?(?<depName>(?:[^\\s\\"\':@{}/]+:\\d+/)?[^\\s\\"\':@{}]+):(?<currentValue>[^\\s\\"\'@{}]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\\"\']?[ \\t]*(?:#[ \\t]*renovate:(?:[ \\t]+datasource=(?<datasource>\\S+))?(?:[ \\t]+packageName=(?<packageName>\\S+))?(?:[ \\t]+extractVersion=(?<extractVersion>\\S+))?(?:[ \\t]+versioning=(?<versioning>\\S+))?)?',
      ],
    },
    {
      description: "Update Grafana dashboard revisions from grafana.com",
      customType: "regex",
      managerFilePatterns: ["**/*.yaml"], // TODO filter more
      matchStrings: [
        "gnetId: (?<depName>\\d+)\\s+revision: (?<currentValue>\\d+)",
      ],
      datasourceTemplate: "grafana-dashboards",
      versioningTemplate: "numeric",
    },
    {
      customType: "regex",
      managerFilePatterns: ["**/*.go"],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
      matchStrings: [
        '//\\s*renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)( extractVersion=(?<extractVersion>.*?))?( versioning=(?<versioning>.*?))?\\sconst .*? = "(?:.*?:)?(?<currentValue>[a-zA-Z0-9-.]+?)"',
      ],
    },
    {
      customType: "regex",
      description: "Update versions annotated with # renovate: in .nix files",
      managerFilePatterns: ["**/*.nix"],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>.+?)( extractVersion=(?<extractVersion>.+?))?( versioning=(?<versioning>.+?))?\\s+\\w+ = "(?<currentValue>.+?)";',
      ],
    },
  ],

  packageRules: [
    {
      description: "wait 3 days before proposing a bugfix update",
      matchUpdateTypes: ["patch"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "wait 7 days before proposing a minor update",
      matchUpdateTypes: ["minor"],
      minimumReleaseAge: "7 days",
    },
    {
      description: "wait 30 days before proposing a major update",
      matchUpdateTypes: ["major"],
      minimumReleaseAge: "30 days",
    },
    {
      description: "bump bcl version fast",
      matchPackageNames: ["becloudless/becloudless"],
      minimumReleaseAge: "1 day",
      versioning: "semver",
    },
    {
      description: "never propose pre-release tags (testing, snapshot, rc, nightly...). The docker versioning sees the suffix as a variant (like `-alpine`), not as a pre-release, so `ignoreUnstable` does not filter them. Package specific rules below can override `allowedVersions`",
      matchDatasources: ["docker"],
      allowedVersions: "!/(^|[-._])(snapshot|testing|nightly|canary|unstable|edge|dev|devel|develop|preview|pre|alpha|beta|rc|test)(\\d+)?([-._]|$)/i",
    },
    {
      matchPackagePatterns: ["mailu"],
      groupName: "mailu",
    },
    {
      matchPackagePatterns: ["intel-gpu"],
      groupName: "intel-gpu",
    },
    {
      description: "jellyfin switched from X.Y.Z to X.Y tags. docker versioning ignores tags with a different number of segments. Exclude dated and rc tags",
      matchPackageNames: ["ghcr.io/jellyfin/jellyfin"],
      versioning: "loose",
      allowedVersions: "/^\\d+\\.\\d+(\\.\\d+)?$/",
    },
    {
      matchPackageNames: ["becloudless/becloudless", "bcl"],
      groupName: "becloudless",
    },
    {
      description: "reduce renovate itself update pressure",
      matchPackageNames: ["renovate"],
      schedule: ["before 2am"],
    },
    {
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}})!:",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["digest"],
      semanticCommitType: "chore",
      commitMessageExtra: "( {{currentDigestShort}} ➔ {{newDigestShort}} )",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
    },
    {
      matchDatasources: ["github-releases"],
      semanticCommitScope: "github-release",
      commitMessageTopic: "release {{depName}}",
    },
    {
      matchDatasources: ["golang-version"],
      rangeStrategy: "bump",
    },
    {
      // Do not update gomod go version for compatibility. Update toolchain instead.
      matchDepTypes: ["golang"],
      matchDepNames: ["go"],
      enabled: false,
    },
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    {
      description: "regenerate the ci-result of the chart in the same commit as the bump. A separate commit pushed on the branch would make Renovate see it as modified by someone else and stop updating it. bcl is mounted in the container by the renovate-cron workflow",
      matchFileNames: ["kube/charts/*/values.yaml", "kube/charts/*/Chart.yaml"],
      postUpgradeTasks: {
        commands: ["/tmp/bcl/bcl kube chart build"],
        workingDirTemplate: "{{{packageFileDir}}}",
        fileFilters: ["kube/charts/*/ci/ci-result.yaml"],
        executionMode: "update",
      },
    },
  ],
}
